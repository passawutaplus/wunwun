{
  "name": "wunwun",
  "version": "1.1.0",
  "description": "WunWun - Sticky Note To-Do. วันวันทำอะไรบ้าง? จดไว้ตรงนี้ ไม่มีลืม — lightweight floating desktop sticky with smart task tracking and local-first cloud sync.",
  "main": "main.js",
  "author": "You",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "test": "node --test \"tests/*.test.js\""
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.wunwun.app",
    "productName": "WunWun",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "sync-service.js",
      "config.defaults.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "note.html",
      "note.css",
      "note.js",
      "snip.html",
      "capture.html",
      "capture.css",
      "capture.js",
      "when-parser.js",
      "reminders.js",
      "assets/**/*"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
